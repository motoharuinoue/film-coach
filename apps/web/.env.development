# 開発サーバー（npm run dev）のときだけ、手元の解析サービスにつなぐ。
# 解析サービスは `cd services/analyzer && uv run film-coach serve` で起動する。
# 公開デモ（npm run build）では使わないので、デモデータだけで動く。
VITE_ANALYZER_URL=http://127.0.0.1:8787

# 改善点の文章を手元の Ollama で書く（`ollama serve`、`ollama pull gemma3:12b`）。
# Ollama が動いていなければ、テンプレートの文章のまま表示する。
VITE_OLLAMA_URL=http://127.0.0.1:11434
VITE_OLLAMA_MODEL=gemma3:12b
